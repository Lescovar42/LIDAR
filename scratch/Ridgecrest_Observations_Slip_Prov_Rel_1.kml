            </dt>
           </dl>
         </td></tr>
        <tr><td style="padding-bottom: 5px;"><strong>Vertical Separation: </strong><i>17 ± 5 cm west side down</i></td></tr>
       </table>
       <table>
        <tr>
        	<td></td>
        </tr>
       </table>
