        	   <dd>
        	   <strong>Length: </strong><i>411 ± 50 cm right-lateral</i><br/>
            </dt>
           </dl>
         </td></tr>
        <tr><td style="padding-bottom: 5px;"><strong>Vertical Separation: </strong><i>20 /+20 cm west side down</i></td></tr>
       </table>
       <table>
        <tr>
        	<td></td>
        </tr>
       </table>
