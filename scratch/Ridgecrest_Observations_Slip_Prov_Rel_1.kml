  <Placemark>
    <name>300 – 316 cm right-lateral</name>
    <Snippet maxLines="0"></Snippet>
    <description>
    	<![CDATA[
       <table>
        <tr style="background-color:#ccd7e5; border-bottom: 1px solid;">
          <td style="text-align: left; font-weight: bold;">Station ID: 12240</td>
          <td style="text-align: right; font-weight: bold;">Observer ID: C4_321</td>
        </tr>
        <tr>
          <td style="text-align: left;"><strong>Principal Observer: </strong><i>N. Barth/CGS</i></td>
          <td style="text-align: right;">
          <div style="color:blue;" class="popup" onclick="myFunction()"><u><strong>Field Team: </strong><i>11/21-2</i></u>
           <span class="popuptext" id="myPopup"><p align="center"><b><u>Team Members</u></b><br/>N. Barth/UCR<br/>B. Haddon/USGS<br/>D. McPhillips/USGS</p></span>
          </div>
          </td>
        </tr>
        <tr>
          <td style="text-align: left;"><strong>Date: </strong><i>November 21, 2019 at 1:21:59 PM PST</i></td>
          <td style="text-align: right;"><strong>Observer Location: </strong><i>At Site</i></td>
        </tr>
        <tr>
          <td style="text-align: left; padding-bottom: 5px;"><strong>Inferred Origin:</strong><i> Tectonic</i></td>
          <td style="text-align: right; padding-bottom: 5px;"><strong>Inferred Source Event:</strong> <i>M7.1</i></td>
        </tr>
       </table>
       <table>
        <tr>
        	<th>Rupture/Deformation Characteristics</th>
        </tr>
        <tr><td><strong>Local Fault Strike: </strong><i>272°</i></td></tr>
        <tr><td><strong>Fault Expression: </strong><i>Not Reported</i></td></tr>
        <tr><td style="padding-bottom: 5px;">
       <dl>
        <dt><u>Description</u></dt>
        <dd style="padding-bottom: 5px;"><i>1.2 m high W side down scarp, 1 m wide on W inner channel (0.92 m wide on E side)-left margin offset along vector 19/342 3.34 m RL&gt;N; 20/340 3.26 m; best slicks 23/352 on 272/67 fault plane. Logged with Devin McPhillips.</i></dd>
       </dl>
      </td></tr>
       </table>
       <table>
        <tr>
        	<th>Slip/Separation Measurements</th>
        </tr>
        <tr><td>
          <dl>  
         	 <dt><strong><u>Slip Vector</u></strong></dt>
        	   <dd>
        	   <strong>Length: </strong><i>326 – 334 cm</i><br/>
              <strong>Plunge: </strong><i>19° – 23°</i><br/>
              <strong>Azimuth: </strong><i>342°</i></dd>
            </dt>
           </dl>
         </td></tr>
        <tr><td>
          <dl>  
         	 <dt><strong><u>Horizontal Offset</u></strong></dt>
        	   <dd>
        	   <strong>Length: </strong><i>300 – 316 cm right-lateral</i><br/>
              <strong>Azimuth: </strong><i>340°</i></dd>
            </dt>
           </dl>
         </td></tr>
        <tr><td style="padding-bottom: 5px;"><strong>Vertical Offset: </strong><i>106 – 130 cm west side down</i></td></tr>
       </table>
       <table>
        <tr>
        	<td></td>
        </tr>
       </table>
         <p style="margin-left: 5px"><strong>Note: </strong><i>Component values computed from ranges of reported vector measurements, Reported fault strike does not appear consistent with far-field strike.</i></p>
       <table>
        <tr>
        	<td></td>
        </tr>
       </table>
      <script>
      function myFunction() {
        var popup = document.getElementById("myPopup");
        popup.classList.toggle("show");
      }
      </script>
     ]]>
    </description>
