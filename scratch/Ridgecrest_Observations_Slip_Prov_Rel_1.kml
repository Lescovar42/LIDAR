        	   <dd>
        	   <strong>Length: </strong><i>2.67 cm right-lateral</i><br/>
            </dt>
           </dl>
         </td></tr>
        <tr><td style="padding-bottom: 5px;"><strong>Vertical Separation: </strong><i>1.52 cm</i></td></tr>
       </table>
       <table>
        <tr>
        	<td></td>
        </tr>
       </table>
