    <name>375 ± 123 cm right-lateral</name>
    <Snippet maxLines="0"></Snippet>
    <description>
    	<![CDATA[
       <table>
        <tr style="background-color:#ccd7e5; border-bottom: 1px solid;">
          <td style="text-align: left; font-weight: bold;">Station ID: 30367</td>
