        	   <dd>
        	   <strong>Length: </strong><i>65 ± 25 cm right-lateral</i><br/>
            </dt>
           </dl>
         </td></tr>
        <tr><td style="padding-bottom: 5px;"><strong>Vertical Separation: </strong><i>15 – 20 cm east side down</i></td></tr>
       </table>
